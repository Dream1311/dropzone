-- returns category key, tier (or nil), color
local function itemInfo(name)
    local t = string.match(name, "^Helmet(%d)$")
    if t then
        local tier = tonumber(t)
        return "helmet", tier, TIER_COLOR[tier] or C_T3
    end
    t = string.match(name, "^Vest(%d)$")
    if t then
        local tier = tonumber(t)
        return "vest", tier, TIER_COLOR[tier] or C_T3
    end
    t = string.match(name, "^Backpack(%d)$")
    if t then
        local tier = tonumber(t)
        return "pack", tier, TIER_COLOR[tier] or C_T3
    end
    if string.find(name, "^Ammo_") then return "ammo", nil, C_AMMO end
    if SCOPE_NAMES[name] then return "scope", nil, C_SCOPE end
    return "other", nil, C_MISC
end

