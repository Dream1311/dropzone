end

-- ================= HELPERS =================
local function d3(a, b)
    if not a or not b then return 9999 end
    local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function project(a, b)
    local pa, okA = WorldToScreen(a)
    local pb, okB = WorldToScreen(b)
    if okA and okB then return pa, pb end
    return nil, nil
end

local function drawSet(list, pool, fallback, tracer, showHP, isItem, boxes, sw, sh)
    local n = 0
    local total = #pool
    for i = 1, #list do
        if n >= total then break end
        local t = list[i]
        local top, bot
        if isItem then
            local p = t.root.Position
            top, bot = project(p + Vector3.new(0, 0.9, 0), p - Vector3.new(0, 0.9, 0))
        else
            top, bot = project(t.head.Position + Vector3.new(0, 0.8, 0), t.root.Position - Vector3.new(0, 3.1, 0))
        end
        if top and bot then
            local h = bot.Y - top.Y
            if h > 5 and h < 1200 then
                n = n + 1
                local s = pool[n]
                local color = t.col or fallback
                local w = h * 0.45
                if boxes then
                    s.box.Color = color
                    s.box.Position = Vector2.new(top.X - w * 0.5, top.Y)
                    s.box.Size = Vector2.new(w, h)
                    s.box.Visible = true
                else
                    s.box.Visible = false
                end
                local label = t.name
                if cfg.dist then label = label .. "  " .. tostring(math.floor(t.d)) .. "m" end
                if showHP and t.hum then
                    local hp = t.hum.Health
                    if hp then label = label .. "  " .. tostring(math.floor(hp)) end
                end
                s.txt.Text = label
                s.txt.Position = Vector2.new(top.X, top.Y - 16)
                s.txt.Color = color
                s.txt.Visible = true
                if tracer then
                    s.ln.From = Vector2.new(sw * 0.5, sh)
                    s.ln.To = Vector2.new(bot.X, bot.Y)
                    s.ln.Color = color
                    s.ln.Visible = true
                else
                    s.ln.Visible = false
                end
            end
        end
    end
    for i = n + 1, total do
        local s = pool[i]
        s.box.Visible = false
        s.txt.Visible = false
        s.ln.Visible = false
    end
    return n
end

-- ================= NO RECOIL / NO SPREAD =================
-- WeaponState keys (live recoil accumulator)
local STATE_KEYS = {
    recoilAccum = true, hDrift = true, recovering = true, sprayCount = true, bloom = true,
}
-- static recoil stats, only inside a table that carries the recoil signature
local REC_KEYS = {
    V = true, H = true, Kick = true, RecoverySpeed = true,
}
-- static spread stats, only inside a table that carries the spread signature
local SP_KEYS = {
    Hip = true, ADS = true, Aim = true,
    Bloom = true, BloomMax = true, BloomRecover = true,
    PelletSpread = true, pelletH = true, pelletV = true,
}

local RC_SCAN = {"recoilAccum", "hDrift", "recovering", "sprayCount", "bloom",
    "V", "H", "Kick", "RecoverySpeed"}
local SP_SCAN = {"Hip", "ADS", "Aim", "Bloom", "BloomMax", "BloomRecover",
    "PelletSpread", "pelletH", "pelletV"}

local anti = {
    rcOn = false, spOn = false,
    scanning = false, ready = false,
    coverRc = false, coverSp = false,
    stale = false, staleAt = 0, lastScanAt = 0,
    rcCache = {}, spCache = {}, rcKeys = {}, spKeys = {},
    rcCount = 0, spCount = 0, err = nil,
}

local function pickKeys(cache, keys)
    local out = {}
    for _, e in ipairs(cache) do keys[e.key] = true end
    for k in pairs(keys) do
        if k ~= true then out[#out + 1] = k end
    end
    table.sort(out)
    return out
end

local function antiScan()
    if anti.scanning then return end
    local wantRc, wantSp = anti.rcOn, anti.spOn
    if not (wantRc or wantSp) then return end

    local keys, seen = {}, {}
    if wantRc then
        for _, k in ipairs(RC_SCAN) do
            if not seen[k] then seen[k] = true; keys[#keys + 1] = k end
        end
    end
    if wantSp then
        for _, k in ipairs(SP_SCAN) do
            if not seen[k] then seen[k] = true; keys[#keys + 1] = k end
        end
    end

    anti.scanning = true
    anti.err = nil
    anti.lastScanAt = tick()
    print("[DZ] scanning " .. tostring(#keys) .. " keys, freeze incoming...")
    task.spawn(function()
        local ok, c = pcall(function() return getgc(keys) end)
        if not (ok and type(c) == "table" and #c > 0) then
            anti.scanning = false
            anti.err = tostring(c)
            print("[DZ] scan failed: " .. tostring(c))
            return
        end

        -- group numeric slots by containing table
        local num = {}
        for _, e in ipairs(c) do
            if e.type == "number" then
                local t = num[e.tbl]
                if not t then t = {}; num[e.tbl] = t end
                t[e.key] = e
            end
        end

        local rc, sp = {}, {}
        local rk, sk = {}, {}
        for _, m in pairs(num) do
            local isState  = m.recoilAccum ~= nil and m.hDrift ~= nil
            local isRecoil = m.RecoverySpeed ~= nil and m.V ~= nil and m.H ~= nil
            local isSpread = m.BloomMax ~= nil and (m.Aim ~= nil or m.ADS ~= nil or m.Bloom ~= nil)
            for k, e in pairs(m) do
                if (isState and STATE_KEYS[k]) or (isRecoil and REC_KEYS[k]) then
                    rc[#rc + 1] = e
                    rk[k] = true
                end
                if isSpread and SP_KEYS[k] then
                    sp[#sp + 1] = e
                    sk[k] = true
                end
            end
        end

        -- fallback: no signature matched at all, take the unmistakable keys only
        if #rc == 0 then
            for _, e in ipairs(c) do
                if e.type == "number" and STATE_KEYS[e.key] then
                    rc[#rc + 1] = e
                    rk[e.key] = true
                end
            end
        end
        if #sp == 0 then
            local only = {Bloom = true, BloomMax = true, BloomRecover = true,
                PelletSpread = true, pelletH = true, pelletV = true}
            for _, e in ipairs(c) do
                if e.type == "number" and only[e.key] then
                    sp[#sp + 1] = e
                    sk[e.key] = true
                end
            end
        end

        anti.rcCache, anti.spCache = rc, sp
        anti.rcKeys, anti.spKeys = pickKeys(rc, rk), pickKeys(sp, sk)
        anti.rcCount, anti.spCount = #rc, #sp
        anti.ready = true
        anti.coverRc, anti.coverSp = wantRc, wantSp
        anti.stale = false
        anti.scanning = false
        print("[DZ] scan done: recoil=" .. tostring(#rc) .. " slots [" ..
            table.concat(anti.rcKeys, ",") .. "]  spread=" .. tostring(#sp) ..
            " slots [" .. table.concat(anti.spKeys, ",") .. "]")
    end)
end

local function antiReset(doScan)
    if anti.scanning then return end
    anti.ready = false
    anti.coverRc, anti.coverSp = false, false
    anti.rcCache, anti.spCache = {}, {}
    anti.rcKeys, anti.spKeys = {}, {}
    anti.rcCount, anti.spCount = 0, 0
    if doScan then antiScan() end
end

-- writes run only while the cache is known fresh
task.spawn(function()
    while running do
        local wantRc, wantSp = anti.rcOn, anti.spOn
        if wantRc or wantSp then
            local missCover = (wantRc and not anti.coverRc) or (wantSp and not anti.coverSp)
            if anti.stale then
                -- weapon tables were rebuilt: do not touch them until re-scan
            elseif not anti.ready or missCover then
                if not anti.scanning then antiScan() end
            else
                if wantRc then
                    for _, k in ipairs(anti.rcKeys) do
                        pcall(applygc, anti.rcCache, k, 0)
                    end
                end
                if wantSp then
                    for _, k in ipairs(anti.spKeys) do
                        pcall(applygc, anti.spCache, k, 0)
                    end
                end
            end
            task.wait(0.04)
        else
            task.wait(0.25)
        end
    end
end)

-- watch the equipped tool: switching weapon / getting in a vehicle rebuilds
-- the weapon tables, so the old addresses go stale
task.spawn(function()
    local function toolSig()
        local ch = lp.Character
        if not ch then return "" end
        local t = {}
        for _, c in ipairs(ch:GetChildren()) do
            if c.ClassName == "Tool" then t[#t + 1] = c.Name end
        end
        table.sort(t)
        return table.concat(t, ",")
    end

    local last = toolSig()
    while running do
        task.wait(0.4)
        local cur = toolSig()
        if cur ~= last then
            last = cur
            anti.stale = true
            anti.staleAt = tick()
        end
        if anti.stale and cfg.autoRescan and (anti.rcOn or anti.spOn)
            and not anti.scanning
            and (tick() - anti.staleAt) > 1.2
            and (tick() - anti.lastScanAt) > 8 then
            antiReset(true)
        end
    end
end)

-- ================= DATA =================
local bots, items, plrs = {}, {}, {}

local function refPos()
    local c = lp.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if r then return r.Position end
    local cam = workspace.CurrentCamera
    return cam and cam.Position or nil
end

task.spawn(function()
    while running do
        local pos = refPos()
        local ws = game.Workspace
        local bl, il, pl = {}, {}, {}
        if cfg.bots or cfg.botTracer then
            local live = ws:FindFirstChild("Live")
            if live then
                for _, m in ipairs(live:GetChildren()) do
                    local head = m:FindFirstChild("Head")
                    local root = m:FindFirstChild("HumanoidRootPart")
                    if head and root then
                        bl[#bl + 1] = {name = m.Name, head = head, root = root,
                            hum = m:FindFirstChildOfClass("Humanoid"), d = d3(pos, root.Position)}
                    end
                end
                table.sort(bl, function(a, b) return a.d < b.d end)
            end
        end
        if cfg.items or cfg.itemTracer then
            local loot = ws:FindFirstChild("Loot")
            if loot then
                for _, m in ipairs(loot:GetChildren()) do
                    if m.ClassName == "Model" then
                        local root = m:FindFirstChild("RootPart")
                        if root then
                            local cat, tier, col = itemInfo(m.Name)
                            if cfg[cat] then
                                local d = d3(pos, root.Position)
                                if d <= cfg.range then
                                    il[#il + 1] = {name = m.Name, root = root, d = d, col = col, tier = tier}
                                end
                            end
                        end
                    end
                end
                table.sort(il, function(a, b) return a.d < b.d end)
            end
        end
        if cfg.players then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp then
                    local char = p.Character
                    local head = char and char:FindFirstChild("Head")
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if head and root then
                        pl[#pl + 1] = {name = p.Name, head = head, root = root,
                            hum = char:FindFirstChildOfClass("Humanoid"), d = d3(pos, root.Position)}
                    end
                end
            end
            table.sort(pl, function(a, b) return a.d < b.d end)
        end
        bots, items, plrs = bl, il, pl
        task.wait(0.5)
    end
end)

-- ================= RENDER =================
local getX = function() return mouse.X end
local getY = function() return mouse.Y end

local conn = RunService.RenderStepped:Connect(function()
    local okx, px = pcall(getX)
    local oky, py = pcall(getY)
    if not (okx and oky) then px, py = -1, -1 end
    local cam = workspace.CurrentCamera
    local sw, sh = 1920, 1080
    if cam then
        local vp = cam.ViewportSize
        if vp then sw, sh = vp.X, vp.Y end
    end
    local nb = drawSet(bots, botPool, C_BOT, cfg.botTracer, cfg.botHP, false, true, sw, sh)
    local ni = drawSet(items, itemPool, C_MISC, cfg.itemTracer, false, true, cfg.items, sw, sh)
    local np = drawSet(plrs, plrPool, C_PLR, false, true, false, true, sw, sh)

    if menuOpen then
        local hover = rowAt(px, py)
        mBg.Visible = true; mBar.Visible = true
        mTitle.Visible = true; mSub.Visible = true
        mClose.Visible = true; mFoot.Visible = true
        mBg.Position = Vector2.new(wx, wy)
        mBg.Size = Vector2.new(MW, MH)
        mBar.Position = Vector2.new(wx, wy)
        mBar.Size = Vector2.new(MW, TITLE_H)
        mTitle.Position = Vector2.new(wx + PAD, wy + 4)
        mSub.Position = Vector2.new(wx + PAD + 78, wy + 8)
        mClose.Position = Vector2.new(wx + MW - 15, wy + 13)
        mFoot.Text = "bots " .. tostring(nb) .. "   items " .. tostring(ni) .. "   players " .. tostring(np)
        mFoot.Position = Vector2.new(wx + PAD, wy + MH - 16)

        local top = wy + TITLE_H + 6
        for i, r in ipairs(rows) do
            local o = rowDraw[i]
            local y = top + (i - 1) * ROW_H
            local on = cfg[r.key]
            o.bg.Position = Vector2.new(wx + PAD, y)
            o.bg.Size = Vector2.new(MW - PAD * 2, ROW_H - 2)
            o.bg.Visible = (hover == i)
            o.lab.Visible = true
            o.lab.Position = Vector2.new(wx + PAD + 26, y + 3)
            o.lab.Color = on and C_TXT or C_DIM

            if r.kind == "check" then
                o.box.Visible = true
                o.box.Position = Vector2.new(wx + PAD + 7, y + 4)
                o.box.Size = Vector2.new(12, 12)
                o.fill.Visible = on
                o.fill.Position = Vector2.new(wx + PAD + 10, y + 7)
                o.fill.Size = Vector2.new(6, 6)
                if r.key == "norecoil" or r.key == "nospread" then
                    o.val.Visible = true
                    if anti.scanning then
                        o.val.Text = "scan"
                        o.val.Color = C_AMMO
                    elseif anti.stale then
                        o.val.Text = "stale"
                        o.val.Color = C_AMMO
                    elseif not anti.ready then
                        o.val.Text = anti.err and "err" or ""
                        o.val.Color = C_DIM
                    else
                        o.val.Text = on and "on" or "off"
                        o.val.Color = on and C_ACC or C_DIM
                    end
                    o.val.Position = Vector2.new(wx + MW - PAD - 34, y + 11)
                else
                    o.val.Visible = false
                end
            elseif r.kind == "action" then
                o.box.Visible = false
                o.fill.Visible = false
                o.val.Visible = true
                o.val.Text = anti.scanning and "scan" or (anti.ready and "re" or "run")
                o.val.Color = anti.scanning and C_AMMO or C_ACC
                o.val.Position = Vector2.new(wx + MW - PAD - 34, y + 11)
            else
                o.box.Visible = false
                o.fill.Visible = false
                o.val.Visible = true
                o.val.Color = C_ACC
                o.val.Text = "-  " .. tostring(cfg.range) .. "m  +"
                o.val.Position = Vector2.new(wx + MW - PAD - 46, y + 11)
            end
        end

        local down = ismouse1pressed()
        if down and not prevDown and px > 0 then
            if px >= wx and px <= wx + MW and py >= wy and py <= wy + MH then
                if py <= wy + TITLE_H then
                    if px >= wx + MW - 28 then
                        menuOpen = false
                    else
                        dragging = true
                        dragDX = px - wx
                        dragDY = py - wy
                    end
                else
                    local idx = rowAt(px, py)
                    if idx > 0 then
                        local r = rows[idx]
                        if r.kind == "check" then
                            cfg[r.key] = not cfg[r.key]
                            if r.key == "norecoil" then
                                anti.rcOn = cfg.norecoil
                                if anti.rcOn and (not anti.ready or anti.stale) then antiReset(true) end
                            elseif r.key == "nospread" then
                                anti.spOn = cfg.nospread
                                if anti.spOn and (not anti.ready or anti.stale) then antiReset(true) end
                            end
                        elseif r.kind == "action" then
                            if not anti.scanning then antiReset(true) end
                        else
                            if px > wx + MW - PAD - 46 then
                                cfg.range = math.min(1000, cfg.range + 50)
                            else
                                cfg.range = math.max(50, cfg.range - 50)
                            end
                        end
                    end
                end
            end
        end
        if down and dragging and px > 0 then
            wx = px - dragDX
            wy = py - dragDY
        end
        if not down then dragging = false end
        prevDown = down
    else
        mBg.Visible = false; mBar.Visible = false
        mTitle.Visible = false; mSub.Visible = false
        mClose.Visible = false; mFoot.Visible = false
        for i = 1, #rows do
            local o = rowDraw[i]
            o.bg.Visible = false; o.box.Visible = false; o.fill.Visible = false
            o.lab.Visible = false; o.val.Visible = false
        end
        dragging = false
        prevDown = ismouse1pressed()
    end
end)

